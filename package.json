{
  "name": "meal-hat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "update-version": "node src/assets/javascript/version.js",
    "serve": "vite",
    "preview": "vite preview",
    "build": "yarn update-version && vite build",
    "check-build": "node scripts/check-build.mjs",
    "lint": "eslint src tests *.js --ext .js,.jsx,.vue --fix && stylelint '**/*.vue' --formatter verbose --fix",
    "deploy": "node scripts/preflight.mjs && yarn build && node scripts/check-build.mjs && ~/aws-cli/aws s3 sync dist/ s3://meal-hat --profile personal-deploy && ~/aws-cli/aws cloudfront create-invalidation --distribution-id E1C9X1FV3WBDN6 --paths '/*' --profile personal-deploy > invalidation_output.txt",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "fetch-bug-reports": "node scripts/fetch-bug-reports.mjs",
    "resolve-bug-report": "node scripts/resolve-bug-report.mjs",
    "talk-runs": "node scripts/talk-runs.mjs",
    "test:emulated": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" firebase emulators:exec --only database \"yarn vitest run --config vitest.integration.config.js\""
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@sentry/vue": "^10",
    "bootstrap": "^5.2.3",
    "bootstrap-icons": "^1.10.3",
    "core-js": "^3.8.3",
    "firebase": "^12",
    "pluralize": "^8.0.0",
    "register-service-worker": "^1.7.2",
    "shepherd.js": "^11.2.0",
    "uuid": "^9.0.0",
    "v-calendar": "^3.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.2.2",
    "vuedraggable": "^4.1.0",
    "vuex": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-standard": "^6.1.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-vue": "^8.0.3",
    "sass": "^1.83.0",
    "stylelint": "13.12.0",
    "stylelint-config-sass-guidelines": "^11.1.0",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "@vue/standard"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "no-trailing-spaces": "warn",
      "eol-last": "off",
      "quotes": [
        "off",
        "double"
      ],
      "semi": "off",
      "comma-dangle": "off",
      "space-before-function-paren": "warn",
      "indent": "warn",
      "no-undef": "warn",
      "padded-blocks": "warn",
      "object-curly-spacing": "warn",
      "array-bracket-spacing": "warn",
      "no-unused-vars": "warn",
      "no-empty": "warn",
      "prefer-const": "warn",
      "no-multiple-empty-lines": "warn",
      "no-useless-return": "off",
      "no-debugger": "warn",
      "no-unmodified-loop-condition": "off",
      "no-constant-condition": "off",
      "comma-spacing": "warn"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "resolutions": {
    "source-map-js": "^1.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1",
    "**/editorconfig/minimatch": "^9.0.9"
  }
}
