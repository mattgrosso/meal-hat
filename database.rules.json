// Realtime Database security rules.
//
// Before this file existed the rules lived only in the Firebase console, and
// they left the database open: an unauthenticated GET of /.json?shallow=true
// returned every top-level key, and those keys are email addresses.
//
// The model: every top-level key is a HAT. A user's own hat is their email with
// punctuation replaced by '-' (mattgrosso-gmail-com); shared hats are whatever
// name their creator typed. Sharing is by name — anyone who knows a hat's name
// can join it from the MealHats screen. These rules keep that, and only that.
//
// Root read is denied, so hats can no longer be enumerated: you have to know
// the name already. That is also why src/store/index.js may not hold a
// root-scoped read (fenced by tests/unit/no-root-database-reads.spec.js) — it
// used to subscribe to the whole database just to build a list of hat names,
// which handed every signed-in client every other account's meals, shopping
// list and grocery catalog.
//
// This is NOT a membership model. A signed-in user who guesses a hat name can
// still read and write it, exactly as the app's sharing has always worked.
// Closing that would need a per-hat member list, which is a product change
// rather than a rules change.
{
  "rules": {
    // Denied at the root: no enumerating hats, no writing the whole database.
    // Read and write grants cascade DOWNWARD in these rules, so the grant on
    // $hat below still applies — a parent's false does not veto a child's true.
    ".read": false,
    ".write": false,

    // In-app bug reports: anyone signed in may FILE one, nobody may read them
    // back. Reports carry the reporter's email, user agent, URL and an app-state
    // snapshot, so they are triaged with the Admin SDK, which bypasses rules.
    //
    // This block is load-bearing, and not for the reason it looks. Without it
    // the $hat wildcard below would match the key "bugReports" like any other
    // top-level key and hand every signed-in user read access to everyone's
    // reports — not the public, but everyone with an account.
    //
    // Verified on the deployed rules (2026-08-19) rather than assumed, because
    // the whole design rests on a named child overriding a $wildcard sibling.
    // Three authenticated reads: the user's own hat returned data; a
    // non-existent top-level key returned empty WITHOUT an error, proving the
    // wildcard grants read to any key; "bugReports" returned Permission denied.
    // The named child wins.
    "bugReports": {
      ".read": false,
      ".write": "auth != null"
    },

    "$hat": {
      // Membership, not name-knowledge.
      //
      // Before 2026-08-19 any signed-in user who guessed a hat name could read
      // and write it — and the names are guessable, being emails with the
      // punctuation swapped for hyphens. Access is now granted only to uids
      // listed under the hat's own `members`.
      //
      // Keyed by auth.uid, NOT by the email-derived database key: rules can
      // test auth.uid directly and have no way to apply the app's punctuation
      // stripping to an email to rebuild a key.
      //
      // The `!data.exists()` clause on write is what still allows creating a
      // brand-new hat. It also gives the app its only honest way to tell "this
      // name is free" from "this hat exists and you cannot see it" — the write
      // is refused in the second case, which is when the user needs an invite
      // link rather than a create prompt.
      //
      // Every existing hat was given members and a joinCode by
      // scripts/backfill-hat-membership.mjs BEFORE this rule was deployed. A
      // hat with no members is readable by nobody, which is the safe direction,
      // but it means the backfill has to be complete — it was verified against
      // all 14 top-level keys first.
      ".read": "auth != null && data.child('members').child(auth.uid).exists()",
      ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists())",

      "members": {
        "$uid": {
          // Joining. A user may add ONLY themselves, and only by presenting the
          // hat's joinCode — which they cannot read until they are a member, so
          // it has to come from a share link.
          //
          // This grant is what makes invite links work at all: the $hat write
          // rule above refuses non-members, and in these rules a grant deeper
          // in the path still applies even where an ancestor denies.
          //
          // The `!root...exists()` fallback covers a hat that predates join
          // codes; nothing in the live database is in that state, but a hat
          // created by an older client would otherwise be unjoinable.
          ".write": "auth != null && auth.uid === $uid && (newData.child('code').val() === root.child($hat).child('joinCode').val() || !root.child($hat).child('joinCode').exists())"
        }
      },


      "drawnMeals": {
        // The client loads only a trailing window of the schedule, via
        // orderByChild('assignedDate'). Without this index Firebase still
        // ANSWERS the query — by downloading the whole node and filtering on the
        // client, which is exactly the cost the query exists to avoid — and
        // warns about it in the console rather than failing. So its absence is
        // silent in behaviour and expensive in practice.
        //
        // Only meaningful because assignedDate is ISO YYYY-MM-DD, which sorts
        // lexically. The old toDateString() form ordered "Fri" before "Mon"
        // before "Sat"; the client migrates a hat before it queries it.
        ".indexOn": "assignedDate"
      }
    }
  }
}
